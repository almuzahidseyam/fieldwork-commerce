AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=fieldwork-commerce
# Local development only. Do not set this in production.
DYNAMODB_ENDPOINT=http://127.0.0.1:8879
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# For AWS, remove DYNAMODB_ENDPOINT and use a restricted IAM identity.
# On Vercel, configure AWS credentials as sensitive server-side variables.
# Recommended Vercel production setup: use AWS_ROLE_ARN with OIDC instead.
# AWS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/fieldwork-vercel-commerce
